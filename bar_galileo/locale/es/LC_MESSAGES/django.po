#: django/contrib/auth/password_validation.py:106
msgid "This password is too short. It must contain at least 8 characters."
msgstr "La contraseña es demasiado corta. Debe contener al menos 8 caracteres."

#: django/contrib/auth/password_validation.py:120
msgid "This password is too common."
msgstr "Esta contraseña es demasiado común."

#: django/contrib/auth/password_validation.py:124
msgid "This password is entirely numeric."
msgstr "La contraseña no puede ser completamente numérica."

#: django/contrib/auth/password_validation.py:98
msgid "The password is too similar to the %(verbose_name)s."
msgstr "La contraseña es demasiado similar a %(verbose_name)s."
